class=\"tusb-nav__link\" href=\"http://127.0.0.1:9500/about/\">About</a></li><li class=\"tusb-nav__item\"><a class=\"tusb-nav__link\" href=\"http://127.0.0.1:9500/blog/\">Blog</a></li><li class=\"tusb-nav__item\"><a class=\"tusb-nav__link\" href=\"http://127.0.0.1:9500/#tusb-seed-contact\">Contact</a></li></ul><div class=\"tusb-mobile-nav__cta\"><a class=\"tusb-btn tusb-btn--primary tusb-btn--primary\" href=\"http://127.0.0.1:9500/#tusb-seed-contact\">Start a project</a></div></div></div></header>","body":"<div class=\"tusb-page tusb-page--home\" data-tusb-doc=\"home\"><section class=\"tusb-section tusb-section--hero\" id=\"tusb-seed-hero\" data-tusb-section=\"seed-hero\" data-tusb-type=\"hero\"><div class=\"tusb-hero tusb-hero--right tusb-hero--no-media\"><div class=\"tusb-container\"><div class=\"tusb-hero__text\"><p class=\"tusb-eyebrow\" data-tusb-field=\"hero:eyebrow\">Design studio</p><h1 class=\"tusb-heading tusb-hero__heading\" data-tusb-field=\"hero:heading\">We build bold <span class=\"tusb-accent\">brands</span></h1><p class=\"tusb-text tusb-hero__text-body\" data-tusb-field=\"hero:text\">Replace this placeholder with a short sentence describing what you do and who you help.</p><div class=\"tusb-actions tusb-hero__actions\" data-tusb-field=\"hero:buttons\"><a class=\"tusb-btn tusb-btn--primary \" href=\"#\">Talk to us</a><a class=\"tusb-btn tusb-btn--primary \" href=\"/work/\">See work</a></div></div></div></div></section><section class=\"tusb-section tusb-section--services\" id=\"tusb-seed-services\" data-tusb-section=\"seed-services\" data-tusb-type=\"services\"><div class=\"tusb-container\"><div class=\"tusb-section__head\"><h2 class=\"tusb-heading \">What we do</h2></div><div class=\"tusb-grid tusb-grid--3 \" data-tusb-collection=\"services\"><article class=\"tusb-card tusb-card--service\" data-tusb-item=\"demo-brand\"><span class=\"tusb-card__icon tusb-icon tusb-icon--sparkle\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 3v6M12 15v6M3 12h6M15 12h6M6 6l3 3M15 15l3 3M18 6l-3 3M9 15l-3 3\"/></svg></span><h3 class=\"tusb-card__title\">Brand strategy</h3><p class=\"tusb-card__text\">Positioning, messaging and identity systems that make a brand easy to recognise and hard to confuse.</p><ul class=\"tusb-card__list\"><li>Positioning workshops</li><li>Visual identity</li></ul></article><article class=\"tusb-card tusb-card--service\" data-tusb-item=\"demo-web\"><span class=\"tusb-card__icon tusb-icon tusb-icon--design\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 3l2.6 5.6 6.1.8-4.4 4.3 1.1 6-5.4-3-5.4 3 1.1-6L3.3 9.4l6.1-.8z\"/></svg></span><h3 class=\"tusb-card__title\">Website design</h3><p class=\"tusb-card__text\">Fast, accessible websites with a clear structure so visitors always know what to do next.</p></article><article class=\"tusb-card tusb-card--service\" data-tusb-item=\"demo-growth\"><span class=\"tusb-card__icon tusb-icon tusb-icon--chart\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/></svg></span><h3 class=\"tusb-card__title\">Growth campaigns</h3><p class=\"tusb-card__text\">Campaign pages, content and measurement that turn attention into enquiries.</p></article></div></div></section><section class=\"tusb-section tusb-section--industries\" id=\"tusb-seed-industries\" data-tusb-section=\"seed-industries\" data-tusb-type=\"industries\"><div class=\"tusb-container\"><div class=\"tusb-section__head\"><h2 class=\"tusb-heading \">Who we work with</h2></div><div class=\"tusb-grid tusb-grid--3 \" data-tusb-collection=\"industries\"><div class=\"tusb-card tusb-card--industry\" data-tusb-item=\"demo-retail\"><div class=\"tusb-card__body\"><h3 class=\"tusb-card__title\">Retail</h3><p class=\"tusb-card__text\">Storefronts and catalogues that feel effortless on a phone.</p></div></div><div class=\"tusb-card tusb-card--industry\" data-tusb-item=\"demo-health\"><div class=\"tusb-card__body\"><h3 class=\"tusb-card__title\">Healthcare</h3><p class=\"tusb-card__text\">Calm, trustworthy information for people making important decisions.</p></div></div><div class=\"tusb-card tusb-card--industry\" data-tusb-item=\"demo-edu\"><div class=\"tusb-card__body\"><h3 class=\"tusb-card__title\">Education</h3><p class=\"tusb-card__text\">Programme pages and portals that keep learners on track.</p></div></div></div></div></section><section class=\"tusb-section tusb-section--philosophy\" id=\"tusb-seed-philosophy\" data-tusb-section=\"seed-philosophy\" data-tusb-type=\"philosophy\"><div class=\"tusb-container\"><div class=\"tusb-split\"><div class=\"tusb-split__main\"><div class=\"tusb-section__head\"><h2 class=\"tusb-heading \">How we think</h2></div></div></div></div></section><section class=\"tusb-section tusb-section--process\" id=\"tusb-seed-process\" data-tusb-section=\"seed-process\" data-tusb-type=\"process\"><div class=\"tusb-container\"><div class=\"tusb-section__head\"><h2 class=\"tusb-heading \">How we work</h2></div></div></section><section class=\"tusb-section tusb-section--case_studies\" id=\"tusb-seed-case_studies\" data-tusb-section=\"seed-case_studies\" data-tusb-type=\"case_studies\"><div class=\"tusb-container\"><div class=\"tusb-section__head\"><h2 class=\"tusb-heading \">Selected work</h2></div><div class=\"tusb-grid tusb-grid--2 \" data-tusb-collection=\"case_studies\"><article class=\"tusb-card tusb-card--case\" data-tusb-item=\"demo-case-1\"><div class=\"tusb-card__body\"><span class=\"tusb-card__kicker\">Sample client</span><h3 class=\"tusb-card__title\">Example project one</h3><p class=\"tusb-card__text\">Replace this summary with what the client needed, what you did and why it worked.</p><p class=\"tusb-card__result\">Add the headline outcome</p><ul class=\"tusb-tags\"><li>Strategy</li><li>UX</li><li>Web</li></ul></div></article><article class=\"tusb-card tusb-card--case\" data-tusb-item=\"demo-case-2\"><div class=\"tusb-card__body\"><span class=\"tusb-card__kicker\">Sample client</span><h3 class=\"tusb-card__title\">Example project two</h3><p class=\"tusb-card__text\">A second placeholder case study so you can see how two cards sit side by side.</p><ul class=\"tusb-tags\"><li>Brand</li><li>Design</li></ul></div></article></div></div></section><section class=\"tusb-section tusb-section--testimonials\" id=\"tusb-seed-testimonials\" data-tusb-section=\"seed-testimonials\" data-tusb-type=\"testimonials\"><div class=\"tusb-container\"><div class=\"tusb-section__head\"><h2 class=\"tusb-heading \">What clients say</h2></div><div class=\"tusb-grid tusb-grid--2 \" data-tusb-collection=\"testimonials\"><figure class=\"tusb-card tusb-card--quote\" data-tusb-item=\"demo-quote-1\"><blockquote class=\"tusb-card__quote\">Replace this with a real client quote. Do not publish placeholder testimonials.</blockquote><figcaption class=\"tusb-card__byline\"><span class=\"tusb-card__byline-text\"><span class=\"tusb-card__name\">Client name</span><span class=\"tusb-card__role\">Role, company</span></span></figcaption></figure></div></div></section><section class=\"tusb-section tusb-section--faq\" id=\"tusb-seed-faq\" data-tusb-section=\"seed-faq\" data-tusb-type=\"faq\"><div class=\"tusb-container\"><div class=\"tusb-section__head\"><h2 class=\"tusb-heading \">Frequently asked questions</h2></div><div class=\"tusb-faq\" data-tusb-collection=\"faq\"><details class=\"tusb-faq__item\" id=\"faq-faq-a\"><summary class=\"tusb-faq__q\">How long does a project take?</summary><div class=\"tusb-faq__a\"><p>Most brand and website projects take four to six weeks from kickoff to launch. <em>We agree the milestones up front</em> so you always know what happens next.</p>\n<p>n</p>\n</div></details><details class=\"tusb-faq__item\" id=\"faq-faq-b\"><summary class=\"tusb-faq__q\">Do you work with small businesses?</summary><div class=\"tusb-faq__a\"><p>Yes u2014 we work with founders, small teams and growing companies. There is no minimum project size.</p>\n<p>n</p>\n</div></details><details class=\"tusb-faq__item\" id=\"faq-faq-c\"><summary class=\"tusb-faq__q\">What do you need from us to start?</summary><div class=\"tusb-faq__a\"><p>Your logo files (if you have them), access to your current site, and one decision-maker who can approve work.</p>\n<p>n</p>\n</div></details><details class=\"tusb-faq__item\" id=\"faq-faq-d\"><summary class=\"tusb-faq__q\">Can you work with our existing website?</summary><div class=\"tusb-faq__a\"><p>Often, yes. We audit what you have first. If the platform is holding you back, we will say so plainly instead of patching around it.</p>\n<p>n</p>\n</div></details><details class=\"tusb-faq__item\" id=\"faq-faq-e\"><summary class=\"tusb-faq__q\">Do we own the design files?</summary><div class=\"tusb-faq__a\"><p>Completely. You get the source files, the fonts licence details and a handover walkthrough.</p>\n<p>n</p>\n</div></details></div></div></section><section class=\"tusb-section tusb-section--cta\" id=\"tusb-seed-cta\" data-tusb-section=\"seed-cta\" data-tusb-type=\"cta\"><div class=\"tusb-container\"><div class=\"tusb-cta\"><h2 class=\"tusb-heading tusb-cta__heading\" data-tusb-field=\"cta:heading\">Ready to start?</h2></div></div></section><section class=\"tusb-section tusb-section--contact\" id=\"tusb-seed-contact\" data-tusb-section=\"seed-contact\" data-tusb-type=\"contact\"><div class=\"tusb-container\"><div class=\"tusb-section__head\"><h2 class=\"tusb-heading \">Get in touch</h2></div><div class=\"tusb-contact\"><div class=\"tusb-contact__details\"><div class=\"tusb-contact__row\"><span class=\"tusb-contact__label\">Email</span><a class=\"tusb-contact__value\" href=\"mailto:admin@example.com\">admin@example.com</a></div></div><div class=\"tusb-contact__form\"><h3 class=\"tusb-contact__form-title\">Send us a message</h3><form class=\"tusb-form\" method=\"post\" action=\"http://127.0.0.1:9500/wp-admin/admin-post.php\"><input type=\"hidden\" name=\"action\" value=\"tusb_contact\" /><input type=\"hidden\" name=\"tusb_redirect\" value=\"http://127.0.0.1:9500/\" /><input type=\"hidden\" id=\"tusb_contact_nonce\" name=\"tusb_contact_nonce\" value=\"3f82fe170f\" /><input type=\"hidden\" name=\"_wp_http_referer\" value=\"/\" /><p class=\"tusb-form__hp\" aria-hidden=\"true\"><label for=\"tusb-website\">Website</label><input type=\"text\" id=\"tusb-website\" name=\"tusb_website\" tabindex=\"-1\" autocomplete=\"off\" /></p><p class=\"tusb-form__field\"><label for=\"tusb-name\">Your name</label><input type=\"text\" id=\"tusb-name\" name=\"tusb_name\" required /></p><p class=\"tusb-form__field\"><label for=\"tusb-email\">Email address</label><input type=\"email\" id=\"tusb-email\" name=\"tusb_email\" required /></p><p class=\"tusb-form__field\"><label for=\"tusb-phone\">Phone (optional)</label><input type=\"tel\" id=\"tusb-phone\" name=\"tusb_phone\" /></p><p class=\"tusb-form__field\"><label for=\"tusb-message\">Message</label><textarea id=\"tusb-message\" name=\"tusb_message\" rows=\"5\" required></textarea></p><p class=\"tusb-form__submit\"><button type=\"submit\" class=\"tusb-btn tusb-btn--primary\">Send message</button></p></form></div></div></div></section></div>","footer":"<footer class=\"tusb-footer\" role=\"contentinfo\"><div class=\"tusb-container\"><div class=\"tusb-footer__grid\"><div class=\"tusb-footer__col tusb-footer__col--brand\"><span class=\"tusb-footer__wordmark\">TrustUsBro</span><p class=\"tusb-footer__text\">Describe your agency in one or two sentences.</p></div><div class=\"tusb-footer__col\"><h2 class=\"tusb-footer__heading\">Navigate</h2><ul class=\"tusb-footer__links\"><li><a href=\"http://127.0.0.1:9500/\">Home</a></li><li><a href=\"http://127.0.0.1:9500/about/\">About</a></li><li><a href=\"http://127.0.0.1:9500/#tusb-seed-case_studies\">Work</a></li></ul></div><div class=\"tusb-footer__col\"><h2 class=\"tusb-footer__heading\">Services</h2></div><div class=\"tusb-footer__col\"><h2 class=\"tusb-footer__heading\">Industries</h2></div></div><div class=\"tusb-footer__bar\"><div class=\"tusb-footer__bar-inner\"><p class=\"tusb-footer__copy\">u00a9 2026 TrustUsBro</p><ul class=\"tusb-footer__legal\"><li><a href=\"http://127.0.0.1:9500/privacy-policy/\">Privacy policy</a></li></ul></div></div></div></footer>","tokens":{"--tusb-color-text":"var(--wp--preset--color--foreground, var(--color-text, var(--text, #111111)))","--tusb-color-heading":"var(--wp--preset--color--foreground, var(--color-heading, var(--text, #111111)))","--tusb-color-muted":"var(--wp--preset--color--gray-600, var(--color-muted, #6b6b6b))","--tusb-color-accent":"var(--wp--preset--color--primary, var(--color-accent, #ff6a00))","--tusb-color-accent-text":"var(--wp--preset--color--background, var(--color-on-accent, #ffffff))","--tusb-color-surface":"var(--wp--preset--color--base-2, var(--color-surface, #ffffff))","--tusb-color-border":"var(--wp--preset--color--gray-200, var(--color-border, rgba(0,0,0,0.12)))","--tusb-color-bg":"var(--wp--preset--color--base, var(--color-bg, #ffffff))","--tusb-font-body":"var(--wp--preset--font-family--body, var(--font-body, inherit))","--tusb-font-heading":"var(--wp--preset--font-family--heading, var(--font-heading, inherit))","--tusb-font-mono":"var(--wp--preset--font-family--monospace, ui-monospace, monospace)","--tusb-radius":"0","--tusb-container-width":"1280px","--tusb-section-space":"96px","--tusb-button-radius":"0"}}