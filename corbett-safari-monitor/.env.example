# ==============================================================================
# Corbett Safari Availability Monitoring & Intelligence System
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env
# ==============================================================================

# --- Target Official Portal (STRICTLY READ-ONLY) ---
CORBETT_PORTAL_URL=https://safari.corbettgov.org/

# --- Database Configuration ---
# SQLite (default for easy local development):
DATABASE_URL=sqlite:///data/corbett_monitor.db
# Separate database used ONLY for clearly labeled [DEMO] sample/test records:
DEMO_DATABASE_URL=sqlite:///data/demo_corbett_monitor.db
# Future PostgreSQL / Supabase migration example (supported by modular backend):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/corbett_monitor

# --- Collection Schedule (Configurable — never hardcoded in code) ---
COLLECTION_TIMEZONE=Asia/Kolkata
MORNING_COLLECTION_TIME=07:30
EVENING_COLLECTION_TIME=19:30
MONITORING_WINDOW_DAYS=30

# Official portal operating hours observed in Phase 1 (corbettgov.org/faq)
PORTAL_OPEN_TIME=05:30
PORTAL_CLOSE_TIME=23:30

# Freshness threshold: warn on dashboard if last successful run is older than N hours
STALE_DATA_THRESHOLD_HOURS=14

# --- Playwright Browser & Polite Access Settings ---
# Keep HEADLESS=false on a local workstation so an authorized human operator can
# review consent notices and grant genuine OS location permission without bypass.
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT_MS=30000
# Persistent local browser profile directory (remembers your genuine consent & location choice)
PLAYWRIGHT_USER_DATA_DIR=data/browser_profile
# Seconds to wait in headed mode for you to click Accept Declaration / Allow Location if shown
CONSENT_WAIT_SECONDS=60
# Polite pacing between page/date/zone reads (seconds) to avoid excessive requests
REQUEST_MIN_DELAY_SECONDS=4.0
REQUEST_MAX_DELAY_SECONDS=8.0
MAX_RETRIES_PER_PAGE=2
RETRY_BACKOFF_SECONDS=5.0

# --- Diagnostics & Selector Configuration ---
SAVE_DIAGNOSTIC_SCREENSHOTS=true
SCREENSHOTS_DIR=data/screenshots
EXPORTS_DIR=data/exports
INSPECTION_DIR=data/inspection
SELECTORS_CONFIG_PATH=config/selectors.json

# --- Logging ---
LOG_LEVEL=INFO
